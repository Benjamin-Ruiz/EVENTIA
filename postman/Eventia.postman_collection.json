            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOjF9.firma-falsa"
              }
            ],
            "url": "{{baseUrl}}/auth/perfil"
          }
        },
        {
          "name": "P6b - Token vencido → 401 (sesión expirada)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('Indica sesión expirada', () => pm.expect(pm.response.json().mensaje).to.include('expirado'));"
