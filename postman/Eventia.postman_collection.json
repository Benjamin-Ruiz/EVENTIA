              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{tokenMaria}}"
                  }
                ],
                "url": "{{baseUrl}}/auth/logout"
              }
            },
            {
              "name": "Reutilizar token de María → 401",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                    ]
