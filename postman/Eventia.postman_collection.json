                }
              ],
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{tokenMaria}}"
                  }
                ],
                "url": "{{baseUrl}}/auth/perfil"
              }
            }
          ]
        }
      ]
