            "url": "{{baseUrl}}/auth/perfil",
            "description": "Genere tokenVencido con: npm run token:vencido (en /backend) y péguelo en la variable de colección tokenVencido."
          }
        },
        {
          "name": "P6c - Token revocado tras logout → 401",
          "item": [
            {
              "name": "Logout de María",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('200 OK', () => pm.response.to.have.status(200));"
